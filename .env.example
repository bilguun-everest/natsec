# Copy to .env and fill in. On Vercel these are injected by the Storage tab —
# `vercel env pull .env` writes them here for local development.

# Postgres connection string. Vercel's Postgres is Neon underneath.
DATABASE_URL=postgres://user:password@host/dbname

# Signs auth cookies and reset tokens. Any long random string;
# generate one with: openssl rand -base64 32
PAYLOAD_SECRET=

# Vercel Blob read/write token. If unset, uploads fall back to local disk,
# which is what you want when developing without a Blob store.
BLOB_READ_WRITE_TOKEN=
